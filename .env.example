# Copy this file to .env for local development.
# Keep the real value private and never commit it.
GEMINI_API_KEY=
# Optional model override, for example gemini-3.6-flash
GEMINI_MODEL=gemini-3.6-flash
# Set this in the Vercel frontend to the public Render API URL.
# Leave empty for the Replit same-origin preview.
VITE_API_BASE_URL=